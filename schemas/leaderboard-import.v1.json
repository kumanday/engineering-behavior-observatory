{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ebo:schema:leaderboard-import:v1",
  "$defs": {
    "hash": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "string": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "uuid": {
      "type": "string",
      "format": "uuid"
    },
    "number": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "group": {
      "type": "array",
      "maxItems": 4,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 4096
      },
      "minItems": 4
    },
    "original": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourceReference",
        "directory"
      ],
      "properties": {
        "sourceReference": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "directory": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        }
      }
    },
    "nativeBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "factId",
        "directory"
      ],
      "properties": {
        "factId": {
          "type": "string",
          "format": "uuid"
        },
        "directory": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "profileId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "originals": {
          "type": "array",
          "maxItems": 128,
          "items": {
            "$ref": "#/$defs/original"
          }
        }
      }
    },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "policyRevision",
        "snapshotRoot",
        "historyCompleteness",
        "nativeBindings"
      ],
      "properties": {
        "schemaVersion": {
          "const": "ebo.leaderboard-cohort-request/v1"
        },
        "policyRevision": {
          "const": "c4a8c4cb468aa1b1e8f3e31c002d2272cc090236"
        },
        "snapshotRoot": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "acquisitionPath": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "historyCompleteness": {
          "enum": [
            "complete",
            "bounded-subset"
          ]
        },
        "nativeBindings": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "$ref": "#/$defs/nativeBinding"
          }
        },
        "withdrawnFactIds": {
          "type": "array",
          "maxItems": 100000,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "format": "uuid"
          }
        },
        "priorCohortId": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        }
      }
    },
    "sourceOutcome": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "factId",
        "group",
        "outcome",
        "authority"
      ],
      "properties": {
        "factId": {
          "type": "string",
          "format": "uuid"
        },
        "group": {
          "$ref": "#/$defs/group"
        },
        "outcome": {
          "enum": [
            "pass",
            "fail",
            "infra"
          ]
        },
        "authority": {
          "const": "third-party"
        }
      }
    },
    "assessmentContext": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "factId",
        "assessmentId",
        "sourceSnapshotDigest",
        "inspectionDigest",
        "nativeScanDigest"
      ],
      "properties": {
        "factId": {
          "type": "string",
          "format": "uuid"
        },
        "assessmentId": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "sourceSnapshotDigest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "inspectionDigest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "nativeScanDigest": {
          "$ref": "#/$defs/hash"
        }
      }
    },
    "member": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "executionId",
        "captureRevision",
        "sourceSnapshotDigest",
        "inspectionDigest",
        "nativeScanDigest",
        "assessmentId",
        "importManifestDigest",
        "factIds",
        "groups",
        "sourceOutcomes",
        "assessments",
        "corpusPath"
      ],
      "properties": {
        "executionId": {
          "type": "string",
          "pattern": "^harbor:[a-f0-9]{64}$"
        },
        "captureRevision": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "sourceSnapshotDigest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "inspectionDigest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "nativeScanDigest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "assessmentId": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "importManifestDigest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "factIds": {
          "type": "array",
          "maxItems": 64,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "format": "uuid"
          }
        },
        "groups": {
          "type": "array",
          "maxItems": 100000,
          "items": {
            "$ref": "#/$defs/group"
          }
        },
        "sourceOutcomes": {
          "type": "array",
          "maxItems": 100000,
          "items": {
            "$ref": "#/$defs/sourceOutcome"
          }
        },
        "assessments": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "$ref": "#/$defs/assessmentContext"
          }
        },
        "corpusPath": {
          "type": "string",
          "pattern": "^corpus/[a-f0-9]{64}$"
        }
      }
    },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "factId",
        "status"
      ],
      "properties": {
        "factId": {
          "type": "string",
          "format": "uuid"
        },
        "status": {
          "enum": [
            "imported",
            "inspect-only",
            "quarantined",
            "missing",
            "withdrawn",
            "not-selected"
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "sourceSnapshotDigest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        }
      }
    },
    "cohort": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "id",
        "sharing",
        "sourceSnapshotDigest",
        "selectionDigest",
        "scannerDigest",
        "scanDigest",
        "historyCompleteness",
        "sourceAuthority",
        "members",
        "cases",
        "selectedSourceRecords",
        "admittedExecutions"
      ],
      "properties": {
        "schemaVersion": {
          "const": "ebo.leaderboard-cohort/v1"
        },
        "id": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "sharing": {
          "const": "restricted"
        },
        "sourceSnapshotDigest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "selectionDigest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "scannerDigest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "scanDigest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "historyCompleteness": {
          "enum": [
            "complete",
            "bounded-subset"
          ]
        },
        "sourceAuthority": {
          "const": "third-party"
        },
        "priorCohortId": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "members": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "$ref": "#/$defs/member"
          }
        },
        "cases": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "$ref": "#/$defs/case"
          }
        },
        "selectedSourceRecords": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "admittedExecutions": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      }
    },
    "acquiredArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "remotePath",
        "localPath",
        "sha256",
        "bytes",
        "listedXetHash",
        "authority"
      ],
      "properties": {
        "remotePath": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "localPath": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "bytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "listedXetHash": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-f0-9]{64}$"
        },
        "observedXetHash": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-f0-9]{64}$"
        },
        "authority": {
          "const": "protected-leaderboard-record"
        }
      }
    },
    "acquisition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "source",
        "retrievedAt",
        "sharing",
        "terms",
        "attribution",
        "artifacts"
      ],
      "properties": {
        "schemaVersion": {
          "const": "ebo.leaderboard-acquisition/v1"
        },
        "source": {
          "const": "https://huggingface.co/buckets/joelniklaus/harness-leaderboard"
        },
        "retrievedAt": {
          "type": "string",
          "format": "date-time"
        },
        "sharing": {
          "const": "restricted"
        },
        "terms": {
          "enum": [
            "unstated",
            "recorded"
          ]
        },
        "attribution": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "artifacts": {
          "type": "array",
          "maxItems": 4096,
          "items": {
            "$ref": "#/$defs/acquiredArtifact"
          }
        }
      }
    },
    "scan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "scanner",
        "scannerDigest",
        "inputDigest",
        "status",
        "findings"
      ],
      "properties": {
        "schemaVersion": {
          "const": "ebo.import-scan/v1"
        },
        "scanner": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "version",
            "moduleDigests"
          ],
          "properties": {
            "id": {
              "const": "ebo.import-secret-patterns"
            },
            "version": {
              "const": "1.0.0"
            },
            "moduleDigests": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "exports.js",
                "redaction.js",
                "leaderboard-source.js"
              ],
              "properties": {
                "exports.js": {
                  "type": "string",
                  "pattern": "^sha256:[a-f0-9]{64}$"
                },
                "redaction.js": {
                  "type": "string",
                  "pattern": "^sha256:[a-f0-9]{64}$"
                },
                "leaderboard-source.js": {
                  "type": "string",
                  "pattern": "^sha256:[a-f0-9]{64}$"
                }
              }
            }
          }
        },
        "scannerDigest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "inputDigest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "status": {
          "enum": [
            "clean",
            "quarantined"
          ]
        },
        "findings": {
          "type": "array",
          "maxItems": 40000,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "digest",
              "reason"
            ],
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4096
              },
              "digest": {
                "type": "string",
                "pattern": "^sha256:[a-f0-9]{64}$"
              },
              "reason": {
                "enum": [
                  "SECRET_PATTERN",
                  "SCAN_UNAVAILABLE"
                ]
              }
            }
          }
        }
      }
    },
    "requestReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "policyRevision",
        "historyCompleteness",
        "factIds",
        "withdrawnFactIds",
        "priorCohortId"
      ],
      "properties": {
        "schemaVersion": {
          "const": "ebo.leaderboard-request-receipt/v1"
        },
        "policyRevision": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "historyCompleteness": {
          "enum": [
            "complete",
            "bounded-subset"
          ]
        },
        "factIds": {
          "type": "array",
          "maxItems": 64,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "format": "uuid"
          }
        },
        "withdrawnFactIds": {
          "type": "array",
          "maxItems": 100000,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "format": "uuid"
          }
        },
        "priorCohortId": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^sha256:[a-f0-9]{64}$"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "policyInput": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "policyRevision",
        "historyCompleteness",
        "facts",
        "runs",
        "invalid"
      ],
      "properties": {
        "schemaVersion": {
          "const": "ebo.leaderboard-policy-input/v1"
        },
        "policyRevision": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "historyCompleteness": {
          "enum": [
            "complete",
            "bounded-subset"
          ]
        },
        "facts": {
          "type": "array",
          "maxItems": 100000,
          "items": {
            "type": "object",
            "maxProperties": 1024
          }
        },
        "runs": {
          "type": "object",
          "maxProperties": 4096,
          "additionalProperties": {
            "type": "object"
          }
        },
        "invalid": {
          "type": "object",
          "maxProperties": 4096,
          "additionalProperties": {
            "type": [
              "object",
              "null"
            ]
          }
        }
      }
    },
    "policyRow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourceIndex",
        "group",
        "id",
        "runId",
        "sourceRunId",
        "outcome",
        "providerExhausted"
      ],
      "properties": {
        "sourceIndex": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "group": {
          "$ref": "#/$defs/group"
        },
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "runId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "sourceRunId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "outcome": {
          "enum": [
            "pass",
            "fail",
            "infra"
          ]
        },
        "providerExhausted": {
          "type": "boolean"
        }
      }
    },
    "policyReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "policy",
        "policyDigest",
        "runtimePolicyDigest",
        "inputDigest",
        "sourceAuthority",
        "historyCompleteness",
        "population",
        "status",
        "diagnostics",
        "rows",
        "excludedSourceIndexes"
      ],
      "properties": {
        "schemaVersion": {
          "const": "ebo.leaderboard-policy-receipt/v1"
        },
        "policy": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "version",
            "revision",
            "packageVersion",
            "files"
          ],
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096
            },
            "version": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096
            },
            "revision": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096
            },
            "packageVersion": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096
            },
            "files": {
              "type": "object",
              "maxProperties": 32,
              "additionalProperties": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            }
          }
        },
        "policyDigest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "runtimePolicyDigest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "inputDigest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "sourceAuthority": {
          "const": "third-party"
        },
        "historyCompleteness": {
          "enum": [
            "complete",
            "bounded-subset"
          ]
        },
        "population": {
          "enum": [
            "retained-complete-source-closure",
            "retained-subset-not-full-board"
          ]
        },
        "status": {
          "enum": [
            "available",
            "unavailable"
          ]
        },
        "diagnostics": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          }
        },
        "rows": {
          "type": "array",
          "maxItems": 100000,
          "items": {
            "$ref": "#/$defs/policyRow"
          }
        },
        "excludedSourceIndexes": {
          "type": "array",
          "maxItems": 100000,
          "uniqueItems": true,
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          }
        }
      }
    },
    "sourceSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "snapshotDigest",
        "source",
        "artifacts"
      ],
      "properties": {
        "schemaVersion": {
          "const": "ebo.leaderboard-source-snapshot/v1"
        },
        "snapshotDigest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "source": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "artifacts": {
          "type": "array",
          "maxItems": 4096,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "remotePath",
              "sha256",
              "bytes",
              "listedXetHash",
              "authority"
            ],
            "properties": {
              "remotePath": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4096
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "bytes": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "listedXetHash": {
                "type": [
                  "string",
                  "null"
                ],
                "pattern": "^[a-f0-9]{64}$"
              },
              "observedXetHash": {
                "type": [
                  "string",
                  "null"
                ],
                "pattern": "^[a-f0-9]{64}$"
              },
              "authority": {
                "const": "protected-leaderboard-record"
              }
            }
          }
        }
      }
    }
  }
}
