{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ebo:schema:behavior-assertions:v1",
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": ".*\\S.*"
    },
    "text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 8192,
      "pattern": ".*\\S.*"
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "versionedIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "version": {
          "$ref": "#/$defs/identifier"
        }
      }
    },
    "evaluatorIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "version": {
          "$ref": "#/$defs/identifier"
        },
        "configurationDigest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        }
      }
    },
    "citation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "eventId",
        "nativeReference"
      ],
      "properties": {
        "eventId": {
          "$ref": "#/$defs/identifier"
        },
        "nativeReference": {
          "$ref": "urn:ebo:schema:uniform-events:v1#/$defs/nativeReference"
        },
        "occurrenceId": {
          "$ref": "#/$defs/identifier"
        }
      }
    },
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "text",
        "citations",
        "workspace"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "text": {
          "$ref": "#/$defs/text"
        },
        "citations": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": {
            "$ref": "#/$defs/citation"
          }
        },
        "workspace": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 4096
        }
      }
    },
    "behavior": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ontologyVersion",
        "cardId"
      ],
      "properties": {
        "ontologyVersion": {
          "$ref": "#/$defs/identifier"
        },
        "cardId": {
          "type": "string",
          "pattern": "^[A-Z]{2}-[0-9]{2}$"
        }
      }
    },
    "verdict": {
      "enum": [
        "present",
        "absent",
        "unknown"
      ]
    },
    "confidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "value",
        "scale"
      ],
      "properties": {
        "value": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "scale": {
          "const": "evaluator-reported-0-to-1"
        }
      }
    },
    "presentJudgment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "verdict",
        "confidence",
        "rationale",
        "alternativeExplanation",
        "citations"
      ],
      "properties": {
        "verdict": {
          "const": "present"
        },
        "value": {
          "$ref": "#/$defs/identifier"
        },
        "confidence": {
          "$ref": "#/$defs/confidence"
        },
        "rationale": {
          "$ref": "#/$defs/text"
        },
        "alternativeExplanation": {
          "$ref": "#/$defs/text"
        },
        "claims": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "$ref": "#/$defs/claim"
          }
        },
        "citations": {
          "type": "array",
          "maxItems": 256,
          "items": {
            "$ref": "#/$defs/citation"
          },
          "minItems": 1
        }
      }
    },
    "absentJudgment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "verdict",
        "confidence",
        "rationale",
        "alternativeExplanation",
        "citations"
      ],
      "properties": {
        "verdict": {
          "const": "absent"
        },
        "confidence": {
          "$ref": "#/$defs/confidence"
        },
        "rationale": {
          "$ref": "#/$defs/text"
        },
        "alternativeExplanation": {
          "$ref": "#/$defs/text"
        },
        "claims": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "$ref": "#/$defs/claim"
          }
        },
        "citations": {
          "type": "array",
          "maxItems": 256,
          "items": {
            "$ref": "#/$defs/citation"
          }
        }
      }
    },
    "unknownJudgment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "verdict",
        "reason",
        "rationale",
        "alternativeExplanation",
        "citations"
      ],
      "properties": {
        "verdict": {
          "const": "unknown"
        },
        "reason": {
          "$ref": "#/$defs/text"
        },
        "missingEvidenceCapability": {
          "type": "string",
          "pattern": "^(?:family:(?:message|model-request|tool|context|permission|delegation|artifact|validation|runtime|outcome)|evidence:(?:nativeOrder|nativeTime|parentage|content))$"
        },
        "rationale": {
          "$ref": "#/$defs/text"
        },
        "alternativeExplanation": {
          "$ref": "#/$defs/text"
        },
        "claims": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "$ref": "#/$defs/claim"
          }
        },
        "citations": {
          "type": "array",
          "maxItems": 256,
          "items": {
            "$ref": "#/$defs/citation"
          }
        }
      }
    },
    "judgment": {
      "oneOf": [
        {
          "$ref": "#/$defs/presentJudgment"
        },
        {
          "$ref": "#/$defs/absentJudgment"
        },
        {
          "$ref": "#/$defs/unknownJudgment"
        }
      ]
    },
    "assertion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "id",
        "runId",
        "attemptId",
        "dataset",
        "behavior",
        "rubric",
        "evaluator",
        "judgment"
      ],
      "properties": {
        "schemaVersion": {
          "const": "ebo.behavior-assertion/v1"
        },
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "runId": {
          "$ref": "#/$defs/identifier"
        },
        "attemptId": {
          "$ref": "#/$defs/identifier"
        },
        "dataset": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "schemaVersion",
            "digest"
          ],
          "properties": {
            "schemaVersion": {
              "const": "ebo.normalized-dataset/v1"
            },
            "digest": {
              "$ref": "#/$defs/digest"
            }
          }
        },
        "behavior": {
          "$ref": "#/$defs/behavior"
        },
        "rubric": {
          "$ref": "#/$defs/versionedIdentity"
        },
        "evaluator": {
          "$ref": "#/$defs/evaluatorIdentity"
        },
        "judgment": {
          "$ref": "#/$defs/judgment"
        }
      }
    },
    "assertionBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "schemaVersion",
        "digest"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "schemaVersion": {
          "const": "ebo.behavior-assertion/v1"
        },
        "digest": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "reviewer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "id"
      ],
      "properties": {
        "kind": {
          "const": "human"
        },
        "id": {
          "$ref": "#/$defs/identifier"
        }
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "id",
        "assertion",
        "state"
      ],
      "properties": {
        "schemaVersion": {
          "const": "ebo.behavior-review/v1"
        },
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "assertion": {
          "$ref": "#/$defs/assertionBinding"
        },
        "state": {
          "enum": [
            "proposed",
            "confirmed",
            "disputed",
            "rejected",
            "insufficient-evidence"
          ]
        },
        "reviewer": {
          "$ref": "#/$defs/reviewer"
        },
        "rationale": {
          "$ref": "#/$defs/text"
        }
      },
      "allOf": [
        {
          "if": {
            "required": [
              "state"
            ],
            "properties": {
              "state": {
                "const": "proposed"
              }
            }
          },
          "then": {
            "not": {
              "required": [
                "reviewer"
              ]
            }
          },
          "else": {
            "required": [
              "reviewer",
              "rationale"
            ]
          }
        }
      ]
    }
  },
  "oneOf": [
    {
      "$ref": "#/$defs/assertion"
    },
    {
      "$ref": "#/$defs/review"
    }
  ]
}
