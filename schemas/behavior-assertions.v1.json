{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ebo:schema:behavior-assertions:v1",
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": ".*\\S.*"
    },
    "text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 8192,
      "pattern": ".*\\S.*"
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "versionedIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "version": {
          "$ref": "#/$defs/identifier"
        }
      }
    },
    "citation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "eventId",
        "nativeReference"
      ],
      "properties": {
        "eventId": {
          "$ref": "#/$defs/identifier"
        },
        "nativeReference": {
          "$ref": "urn:ebo:schema:uniform-events:v1#/$defs/nativeReference"
        },
        "occurrenceId": {
          "$ref": "#/$defs/identifier"
        }
      }
    },
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "text",
        "citations",
        "workspace"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "text": {
          "$ref": "#/$defs/text"
        },
        "citations": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": {
            "$ref": "#/$defs/citation"
          }
        },
        "workspace": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 4096
        }
      }
    },
    "behavior": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ontologyVersion",
        "cardId"
      ],
      "properties": {
        "ontologyVersion": {
          "$ref": "#/$defs/identifier"
        },
        "cardId": {
          "type": "string",
          "pattern": "^[A-Z]{2}-[0-9]{2}$"
        }
      }
    },
    "judgedBehavior": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ontologyVersion",
        "ontologyDigest",
        "cardId"
      ],
      "properties": {
        "ontologyVersion": {
          "$ref": "#/$defs/identifier"
        },
        "ontologyDigest": {
          "$ref": "#/$defs/digest"
        },
        "cardId": {
          "type": "string",
          "pattern": "^[A-Z]{2}-[0-9]{2}$"
        }
      }
    },
    "verdict": {
      "enum": [
        "present",
        "absent",
        "unknown"
      ]
    },
    "confidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "value",
        "scale"
      ],
      "properties": {
        "value": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "scale": {
          "const": "evaluator-reported-0-to-1"
        }
      }
    },
    "producerMode": {
      "enum": [
        "llm-judge",
        "decision-model"
      ]
    },
    "llmJudgeProducer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "provider",
        "model",
        "version"
      ],
      "properties": {
        "mode": {
          "const": "llm-judge"
        },
        "provider": {
          "$ref": "#/$defs/identifier"
        },
        "model": {
          "$ref": "#/$defs/identifier"
        },
        "version": {
          "$ref": "#/$defs/identifier"
        },
        "configurationDigest": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "decisionModelProducer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "provider",
        "model",
        "version"
      ],
      "properties": {
        "mode": {
          "const": "decision-model"
        },
        "provider": {
          "$ref": "#/$defs/identifier"
        },
        "model": {
          "$ref": "#/$defs/identifier"
        },
        "version": {
          "$ref": "#/$defs/identifier"
        },
        "configurationDigest": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "producer": {
      "oneOf": [
        {
          "$ref": "#/$defs/llmJudgeProducer"
        },
        {
          "$ref": "#/$defs/decisionModelProducer"
        }
      ]
    },
    "llmJudgeEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scope",
        "events",
        "structuralObservations",
        "occurrenceLedgerRows",
        "omitted",
        "truncated",
        "limits"
      ],
      "properties": {
        "scope": {
          "const": "selected-events"
        },
        "events": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "included",
            "total"
          ],
          "properties": {
            "included": {
              "type": "integer",
              "minimum": 0
            },
            "total": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "structuralObservations": {
          "type": "integer",
          "minimum": 0
        },
        "occurrenceLedgerRows": {
          "type": "integer",
          "minimum": 0
        },
        "omitted": {
          "type": "integer",
          "minimum": 0
        },
        "truncated": {
          "type": "integer",
          "minimum": 0
        },
        "limits": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "maxEvidenceItems",
            "maxRecordChars",
            "maxInputChars",
            "maxCitations"
          ],
          "properties": {
            "maxEvidenceItems": {
              "type": "integer",
              "minimum": 1
            },
            "maxRecordChars": {
              "type": "integer",
              "minimum": 1
            },
            "maxInputChars": {
              "type": "integer",
              "minimum": 1
            },
            "maxCitations": {
              "type": "integer",
              "minimum": 1
            }
          }
        }
      }
    },
    "decisionModelEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scope",
        "steps",
        "rendering",
        "fieldChars",
        "budgetChars"
      ],
      "properties": {
        "scope": {
          "enum": [
            "all-steps",
            "step-excerpt"
          ]
        },
        "steps": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "included",
            "total"
          ],
          "properties": {
            "included": {
              "type": "integer",
              "minimum": 0
            },
            "total": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "rendering": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "version"
          ],
          "properties": {
            "id": {
              "$ref": "#/$defs/identifier"
            },
            "version": {
              "$ref": "#/$defs/identifier"
            }
          }
        },
        "fieldChars": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "min",
            "max"
          ],
          "properties": {
            "min": {
              "type": "integer",
              "minimum": 0
            },
            "max": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "budgetChars": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "presentJudgment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "basis",
        "verdict",
        "confidence",
        "rationale",
        "alternativeExplanation",
        "citations"
      ],
      "properties": {
        "basis": {
          "const": "cited-evidence"
        },
        "verdict": {
          "const": "present"
        },
        "value": {
          "$ref": "#/$defs/identifier"
        },
        "confidence": {
          "$ref": "#/$defs/confidence"
        },
        "rationale": {
          "$ref": "#/$defs/text"
        },
        "alternativeExplanation": {
          "$ref": "#/$defs/text"
        },
        "claims": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "$ref": "#/$defs/claim"
          }
        },
        "citations": {
          "type": "array",
          "maxItems": 256,
          "items": {
            "$ref": "#/$defs/citation"
          },
          "minItems": 1
        }
      }
    },
    "absentJudgment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "basis",
        "verdict",
        "confidence",
        "rationale",
        "alternativeExplanation",
        "citations"
      ],
      "properties": {
        "basis": {
          "const": "cited-evidence"
        },
        "verdict": {
          "const": "absent"
        },
        "confidence": {
          "$ref": "#/$defs/confidence"
        },
        "rationale": {
          "$ref": "#/$defs/text"
        },
        "alternativeExplanation": {
          "$ref": "#/$defs/text"
        },
        "claims": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "$ref": "#/$defs/claim"
          }
        },
        "citations": {
          "type": "array",
          "maxItems": 256,
          "items": {
            "$ref": "#/$defs/citation"
          }
        }
      }
    },
    "unknownJudgment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "basis",
        "verdict",
        "reason",
        "rationale",
        "alternativeExplanation",
        "citations"
      ],
      "properties": {
        "basis": {
          "const": "cited-evidence"
        },
        "verdict": {
          "const": "unknown"
        },
        "reason": {
          "$ref": "#/$defs/text"
        },
        "missingEvidenceCapability": {
          "type": "string",
          "pattern": "^(?:family:(?:message|model-request|tool|context|permission|delegation|artifact|validation|runtime|outcome)|evidence:(?:nativeOrder|nativeTime|parentage|content))$"
        },
        "rationale": {
          "$ref": "#/$defs/text"
        },
        "alternativeExplanation": {
          "$ref": "#/$defs/text"
        },
        "claims": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "$ref": "#/$defs/claim"
          }
        },
        "citations": {
          "type": "array",
          "maxItems": 256,
          "items": {
            "$ref": "#/$defs/citation"
          }
        }
      }
    },
    "llmJudgment": {
      "oneOf": [
        {
          "$ref": "#/$defs/presentJudgment"
        },
        {
          "$ref": "#/$defs/absentJudgment"
        },
        {
          "$ref": "#/$defs/unknownJudgment"
        }
      ]
    },
    "decisionModelJudgment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "basis",
        "verdict",
        "probabilities",
        "thresholds"
      ],
      "properties": {
        "basis": {
          "const": "probabilities"
        },
        "verdict": {
          "$ref": "#/$defs/verdict"
        },
        "value": {
          "$ref": "#/$defs/identifier"
        },
        "probabilities": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "present",
                "nearMiss",
                "absent"
              ],
              "properties": {
                "present": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                "nearMiss": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                "absent": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "applies",
                "values"
              ],
              "properties": {
                "applies": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                "values": {
                  "type": "object",
                  "minProperties": 2,
                  "maxProperties": 16,
                  "additionalProperties": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  }
                }
              }
            }
          ]
        },
        "thresholds": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "present",
            "absent"
          ],
          "properties": {
            "present": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 1
            },
            "absent": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 1
            }
          }
        }
      }
    },
    "judgment": {
      "oneOf": [
        {
          "$ref": "#/$defs/llmJudgment"
        },
        {
          "$ref": "#/$defs/decisionModelJudgment"
        }
      ]
    },
    "llmJudgeAssertion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "id",
        "runId",
        "attemptId",
        "dataset",
        "behavior",
        "producer",
        "rubric",
        "evidence",
        "judgment"
      ],
      "properties": {
        "schemaVersion": {
          "const": "ebo.behavior-assertion/v2"
        },
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "runId": {
          "$ref": "#/$defs/identifier"
        },
        "attemptId": {
          "$ref": "#/$defs/identifier"
        },
        "dataset": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "schemaVersion",
            "digest"
          ],
          "properties": {
            "schemaVersion": {
              "const": "ebo.normalized-dataset/v1"
            },
            "digest": {
              "$ref": "#/$defs/digest"
            }
          }
        },
        "behavior": {
          "$ref": "#/$defs/judgedBehavior"
        },
        "producer": {
          "$ref": "#/$defs/llmJudgeProducer"
        },
        "rubric": {
          "$ref": "#/$defs/versionedIdentity"
        },
        "evidence": {
          "$ref": "#/$defs/llmJudgeEvidence"
        },
        "judgment": {
          "$ref": "#/$defs/llmJudgment"
        }
      }
    },
    "decisionModelAssertion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "id",
        "runId",
        "attemptId",
        "dataset",
        "behavior",
        "producer",
        "evidence",
        "judgment"
      ],
      "properties": {
        "schemaVersion": {
          "const": "ebo.behavior-assertion/v2"
        },
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "runId": {
          "$ref": "#/$defs/identifier"
        },
        "attemptId": {
          "$ref": "#/$defs/identifier"
        },
        "dataset": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "schemaVersion",
            "digest"
          ],
          "properties": {
            "schemaVersion": {
              "const": "ebo.normalized-dataset/v1"
            },
            "digest": {
              "$ref": "#/$defs/digest"
            }
          }
        },
        "behavior": {
          "$ref": "#/$defs/judgedBehavior"
        },
        "producer": {
          "$ref": "#/$defs/decisionModelProducer"
        },
        "evidence": {
          "$ref": "#/$defs/decisionModelEvidence"
        },
        "judgment": {
          "$ref": "#/$defs/decisionModelJudgment"
        }
      }
    },
    "assertion": {
      "type": "object",
      "required": [
        "producer"
      ],
      "properties": {
        "producer": {
          "type": "object",
          "required": [
            "mode"
          ],
          "properties": {
            "mode": {
              "$ref": "#/$defs/producerMode"
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "producer": {
                "properties": {
                  "mode": {
                    "const": "decision-model"
                  }
                }
              }
            }
          },
          "then": {
            "$ref": "#/$defs/decisionModelAssertion"
          },
          "else": {
            "$ref": "#/$defs/llmJudgeAssertion"
          }
        }
      ]
    },
    "assertionBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "schemaVersion",
        "digest"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "schemaVersion": {
          "const": "ebo.behavior-assertion/v2"
        },
        "digest": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "reviewer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "id"
      ],
      "properties": {
        "kind": {
          "const": "human"
        },
        "id": {
          "$ref": "#/$defs/identifier"
        }
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "id",
        "assertion",
        "state"
      ],
      "properties": {
        "schemaVersion": {
          "const": "ebo.behavior-review/v1"
        },
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "assertion": {
          "$ref": "#/$defs/assertionBinding"
        },
        "state": {
          "enum": [
            "proposed",
            "confirmed",
            "disputed",
            "rejected",
            "insufficient-evidence"
          ]
        },
        "reviewer": {
          "$ref": "#/$defs/reviewer"
        },
        "rationale": {
          "$ref": "#/$defs/text"
        }
      },
      "allOf": [
        {
          "if": {
            "required": [
              "state"
            ],
            "properties": {
              "state": {
                "const": "proposed"
              }
            }
          },
          "then": {
            "not": {
              "required": [
                "reviewer"
              ]
            }
          },
          "else": {
            "required": [
              "reviewer",
              "rationale"
            ]
          }
        }
      ]
    }
  },
  "oneOf": [
    {
      "$ref": "#/$defs/assertion"
    },
    {
      "$ref": "#/$defs/review"
    }
  ]
}
