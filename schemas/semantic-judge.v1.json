{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ebo:schema:semantic-judge:v1",
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024,
      "pattern": ".*\\S.*"
    },
    "text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 16384,
      "pattern": ".*\\S.*"
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "behavior": { "$ref": "urn:ebo:schema:behavior-assertions:v1#/$defs/behavior" },
    "card": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "kind", "unit", "definition", "evidenceTest", "nearMiss"],
      "properties": {
        "id": { "type": "string", "pattern": "^[A-Z]{2}-[0-9]{2}$" },
        "title": { "$ref": "#/$defs/identifier" },
        "kind": { "enum": ["workflow", "dimension", "finding"] },
        "unit": { "enum": ["call-result", "change", "episode", "trajectory"] },
        "definition": { "type": "string", "minLength": 1, "maxLength": 8192 },
        "trigger": { "type": "string", "minLength": 1, "maxLength": 8192 },
        "evidenceTest": { "type": "string", "minLength": 1, "maxLength": 8192 },
        "nearMiss": { "type": "string", "minLength": 1, "maxLength": 8192 },
        "values": { "type": "array", "minItems": 2, "maxItems": 16, "items": { "type": "object", "additionalProperties": false, "required": ["name", "test"], "properties": { "name": { "$ref": "#/$defs/identifier" }, "test": { "type": "string", "minLength": 1, "maxLength": 8192 } } } }
      }
    },
    "rubric": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "instructions"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "version": { "$ref": "#/$defs/identifier" },
        "instructions": { "$ref": "#/$defs/text" }
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["maxEvidenceItems", "maxRecordChars", "maxInputChars", "maxOutputChars", "maxCitations", "maxTurns"],
      "properties": {
        "maxEvidenceItems": { "type": "integer", "minimum": 1, "maximum": 128 },
        "maxRecordChars": { "type": "integer", "minimum": 256, "maximum": 65536 },
        "maxInputChars": { "type": "integer", "minimum": 1024, "maximum": 1000000 },
        "maxOutputChars": { "type": "integer", "minimum": 256, "maximum": 65536 },
        "maxCitations": { "type": "integer", "minimum": 1, "maximum": 64 },
        "maxWallClockMs": { "type": "integer", "minimum": 100, "maximum": 300000 },
        "maxTurns": { "type": "integer", "minimum": 1, "maximum": 10 },
        "maxBudgetUsd": { "type": "number", "exclusiveMinimum": 0, "maximum": 100 }
      }
    },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "id", "behavior", "rubric", "evaluator", "selection", "limits", "blinding"],
      "allOf": [{
        "if": { "properties": { "evaluator": { "required": ["backend"], "properties": { "backend": { "const": "codex-app-server" } } } } },
        "then": { "properties": {
          "evaluator": { "properties": { "provider": { "const": "openai" } } },
          "limits": { "properties": { "maxTurns": { "const": 1 } }, "not": { "required": ["maxBudgetUsd"] } }
        } },
        "else": { "properties": { "evaluator": {
          "properties": { "provider": { "const": "anthropic" }, "backend": { "const": "claude-agent-sdk" }, "effort": { "enum": ["low", "medium", "high", "xhigh", "max"] } },
          "not": { "required": ["executable"] }
        } } }
      }],
      "properties": {
        "schemaVersion": { "const": "ebo.semantic-judge-request/v2" },
        "id": { "type": "string", "minLength": 1, "maxLength": 220, "pattern": ".*\\S.*" },
        "behavior": { "$ref": "#/$defs/behavior" },
        "rubric": { "$ref": "#/$defs/rubric" },
        "evaluator": {
          "type": "object",
          "additionalProperties": false,
          "required": ["provider", "model", "effort"],
          "properties": {
            "backend": { "enum": ["claude-agent-sdk", "codex-app-server"] },
            "executable": { "type": "string", "minLength": 1, "maxLength": 4096, "pattern": ".*\\S.*" },
            "provider": { "enum": ["anthropic", "openai"] },
            "model": { "type": "string", "minLength": 1, "maxLength": 220, "pattern": ".*\\S.*" },
            "effort": { "enum": ["none", "minimal", "low", "medium", "high", "xhigh", "max", "ultra"] }
          }
        },
        "selection": {
          "type": "object",
          "additionalProperties": false,
          "required": ["eventIds", "structuralObservationIds", "includeOutcomeObservations"],
          "properties": {
            "eventIds": { "type": "array", "maxItems": 128, "uniqueItems": true, "items": { "$ref": "#/$defs/identifier" } },
            "structuralObservationIds": { "type": "array", "maxItems": 128, "uniqueItems": true, "items": { "$ref": "#/$defs/identifier" } },
            "includeOutcomeObservations": { "type": "boolean" },
            "occurrences": {
              "type": "object",
              "additionalProperties": false,
              "required": ["types"],
              "properties": {
                "types": { "$ref": "#/$defs/occurrenceTypes" },
                "ratingsDigest": { "$ref": "#/$defs/digest" }
              }
            },
            "frame": { "$ref": "#/$defs/frame" }
          }
        },
        "limits": { "$ref": "#/$defs/limits" },
        "blinding": {
          "type": "object",
          "additionalProperties": false,
          "required": ["evaluatedModelIdentity"],
          "properties": { "evaluatedModelIdentity": { "enum": ["redact", "retain"] } }
        }
      }
    },
    "inputLimits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["maxEvidenceItems", "maxRecordChars", "maxInputChars", "maxCitations"],
      "properties": {
        "maxEvidenceItems": { "type": "integer", "minimum": 1, "maximum": 128 },
        "maxRecordChars": { "type": "integer", "minimum": 256, "maximum": 65536 },
        "maxInputChars": { "type": "integer", "minimum": 1024, "maximum": 1000000 },
        "maxCitations": { "type": "integer", "minimum": 1, "maximum": 64 }
      }
    },
    "occurrenceTypes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "enum": ["failure-response", "validation-run", "source-change", "repeated-operation", "compaction", "delegation"] }
    },
    "frame": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method", "strata"],
      "properties": {
        "method": { "type": "string", "minLength": 1, "maxLength": 2048 },
        "strata": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["type", "population", "ledgerRows", "fullRecords"],
            "properties": {
              "type": { "$ref": "#/$defs/identifier" },
              "population": { "type": "integer", "minimum": 0 },
              "ledgerRows": { "type": "integer", "minimum": 0 },
              "fullRecords": { "type": "integer", "minimum": 0 },
              "unavailable": { "type": "string", "minLength": 1, "maxLength": 1024 }
            }
          }
        }
      }
    },
    "stringList": {
      "type": "array",
      "maxItems": 256,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/identifier" }
    },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "promptVersion", "runId", "attemptId", "dataset", "behavior", "card", "codingRules", "rubric", "selection", "blinding", "limits", "evidence"],
      "properties": {
        "schemaVersion": { "const": "ebo.semantic-judge-input/v2" },
        "sourceEvidence": { "type": "object", "additionalProperties": false, "required": ["qualification", "scope", "completeness", "limitations"], "properties": { "qualification": { "const": "imported" }, "scope": { "const": "retained-source" }, "completeness": { "const": "unproven" }, "limitations": { "type": "array", "items": { "type": "string" } } } },
        "promptVersion": { "$ref": "#/$defs/identifier" },
        "runId": { "$ref": "#/$defs/identifier" },
        "attemptId": { "$ref": "#/$defs/identifier" },
        "dataset": {
          "type": "object",
          "additionalProperties": false,
          "required": ["schemaVersion", "digest"],
          "properties": {
            "schemaVersion": { "const": "ebo.normalized-dataset/v1" },
            "digest": { "$ref": "#/$defs/digest" }
          }
        },
        "behavior": { "$ref": "#/$defs/behavior" },
        "card": { "$ref": "#/$defs/card" },
        "codingRules": { "type": "array", "maxItems": 32, "items": { "type": "string", "minLength": 1, "maxLength": 8192 } },
        "rubric": { "$ref": "#/$defs/rubric" },
        "selection": {
          "type": "object",
          "additionalProperties": false,
          "required": ["datasetEventCount", "requestedEventIds", "requestedStructuralObservationIds", "includedEventIds", "includedStructuralObservationIds", "omitted", "truncated"],
          "properties": {
            "datasetEventCount": { "type": "integer", "minimum": 0 },
            "requestedEventIds": { "$ref": "#/$defs/stringList" },
            "requestedStructuralObservationIds": { "$ref": "#/$defs/stringList" },
            "includedEventIds": { "$ref": "#/$defs/stringList" },
            "includedStructuralObservationIds": { "$ref": "#/$defs/stringList" },
            "omitted": { "$ref": "#/$defs/stringList" },
            "truncated": { "$ref": "#/$defs/stringList" },
            "occurrenceTypes": { "$ref": "#/$defs/occurrenceTypes" },
            "ledgerOccurrenceIds": { "type": "array", "maxItems": 1000000, "uniqueItems": true, "items": { "$ref": "#/$defs/identifier" } },
            "ratingsDigest": { "$ref": "#/$defs/digest" },
            "frame": { "$ref": "#/$defs/frame" }
          }
        },
        "blinding": {
          "type": "object",
          "additionalProperties": false,
          "required": ["evaluatedModelIdentity", "redactionCount", "sourceIdentityPreserved", "residualClues"],
          "properties": {
            "evaluatedModelIdentity": { "enum": ["redacted", "retained"] },
            "redactionCount": { "type": "integer", "minimum": 0 },
            "sourceIdentityPreserved": { "const": true },
            "residualClues": { "$ref": "#/$defs/stringList" }
          }
        },
        "limits": { "$ref": "#/$defs/inputLimits" },
        "evidence": {
          "type": "array",
          "maxItems": 4096,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "id", "content", "truncated"],
            "properties": {
              "kind": { "enum": ["event", "structural-observation", "occurrence-ledger"] },
              "id": { "$ref": "#/$defs/identifier" },
              "citation": {
                "type": "object",
                "additionalProperties": false,
                "required": ["eventId", "nativeReference"],
                "properties": {
                  "eventId": { "$ref": "#/$defs/identifier" },
                  "nativeReference": { "$ref": "urn:ebo:schema:uniform-events:v1#/$defs/nativeReference" }
                }
              },
              "content": { "type": "string", "maxLength": 65568 },
              "truncated": { "type": "boolean" }
            }
          }
        }
      }
    },
    "reference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "digest", "sharingClass"],
      "properties": {
        "path": { "type": "string", "pattern": "^[^/]+$", "minLength": 1, "maxLength": 256 },
        "digest": { "$ref": "#/$defs/digest" },
        "sharingClass": { "const": "restricted" },
        "truncated": { "type": "boolean" }
      }
    },
    "timingAvailability": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "value"],
          "properties": {
            "status": { "const": "available" },
            "value": {
              "type": "object",
              "additionalProperties": false,
              "required": ["durationMs", "durationApiMs"],
              "properties": {
                "durationMs": { "type": "number", "minimum": 0 },
                "durationApiMs": { "type": "number", "minimum": 0 }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "reason"],
          "properties": { "status": { "const": "unavailable" }, "reason": { "$ref": "#/$defs/text" } }
        }
      ]
    },
    "usageAvailability": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "value"],
          "properties": {
            "status": { "const": "available" },
            "value": {
              "type": "object",
              "additionalProperties": false,
              "required": ["totalCostUsd", "numTurns", "mainLoop", "byModel"],
              "properties": {
                "totalCostUsd": { "type": "number", "minimum": 0 },
                "numTurns": { "type": "integer", "minimum": 0 },
                "mainLoop": {},
                "byModel": {}
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "reason"],
          "properties": { "status": { "const": "unavailable" }, "reason": { "$ref": "#/$defs/text" } }
        }
      ]
    }
  },
  "oneOf": [
    { "$ref": "#/$defs/request" },
    { "$ref": "#/$defs/input" }
  ]
}
