{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ebo:schema:atlas-bundle:v1",
  "$defs": {
    "identifier": { "type": "string", "minLength": 1, "maxLength": 1024, "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$" },
    "path": { "type": "string", "minLength": 1, "maxLength": 4096 },
    "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "id", "title", "cohorts"],
      "properties": {
        "schemaVersion": { "const": "ebo.atlas-bundle-request/v2" },
        "id": { "$ref": "#/$defs/identifier" },
        "title": { "type": "string", "minLength": 1, "maxLength": 1000 },
        "cohorts": {
          "type": "array", "minItems": 1, "maxItems": 100,
          "items": {
            "type": "object", "additionalProperties": false, "required": ["id", "atlasRequest"],
            "properties": { "id": { "$ref": "#/$defs/identifier" }, "atlasRequest": { "$ref": "#/$defs/path" } }
          }
        },
        "condition": {
          "type": "object", "additionalProperties": false, "required": ["pattern"],
          "properties": { "pattern": { "type": "string", "minLength": 1, "maxLength": 1000 } }
        },
        "claims": { "$ref": "#/$defs/path" },
        "views": { "$ref": "#/$defs/path" },
        "leaderboard": {
          "type": "object", "additionalProperties": false, "required": ["store", "cohortId"],
          "properties": { "store": { "$ref": "#/$defs/path" }, "cohortId": { "$ref": "#/$defs/digest" } }
        },
        "embeddings": {
          "type": "object", "additionalProperties": false,
          "properties": {
            "provider": { "enum": ["embeddinggemma", "hashed-tfidf"] },
            "model": { "type": "string", "minLength": 1 },
            "revision": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
            "dimensions": { "type": "integer", "minimum": 1, "maximum": 8192 },
            "cache": { "$ref": "#/$defs/path" },
            "python": { "$ref": "#/$defs/path" },
            "device": { "enum": ["auto", "cuda", "mps", "cpu"] },
            "batchSize": { "type": "integer", "minimum": 1, "maximum": 65536 },
            "tokenBudget": { "type": "integer", "minimum": 1, "maximum": 16777216 },
            "maxTokens": { "type": "integer", "minimum": 16, "maximum": 32768 },
            "layout": { "enum": ["auto", "browser", "build"] }
          }
        }
      }
    },
    "bundle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "id", "title", "builder", "tablesVersion", "unitsVersion", "cloud", "createdAt", "request", "cohorts", "tables", "files"],
      "properties": {
        "schemaVersion": { "const": "ebo.atlas-bundle/v2" },
        "id": { "$ref": "#/$defs/identifier" },
        "title": { "type": "string", "minLength": 1, "maxLength": 1000 },
        "builder": {
          "type": "object", "additionalProperties": false, "required": ["id", "version"],
          "properties": { "id": { "const": "ebo-atlas-bundle" }, "version": { "type": "string", "minLength": 1 } }
        },
        "tablesVersion": { "type": "string", "minLength": 1 },
        "unitsVersion": { "type": "string", "minLength": 1 },
        "derivedFrom": {
          "type": "object", "additionalProperties": false, "required": ["bundle", "manifestSha256", "variant"],
          "properties": { "bundle": { "$ref": "#/$defs/identifier" }, "manifestSha256": { "$ref": "#/$defs/digest" }, "variant": { "enum": ["partner", "restricted"] } }
        },
        "cloud": {
          "type": "object", "additionalProperties": false, "required": ["units", "embeddings"],
          "properties": {
            "units": { "type": "integer", "minimum": 0 },
            "layout": {
              "type": "object", "additionalProperties": false, "required": ["where"],
              "properties": { "where": { "enum": ["build", "browser"] }, "compact": { "const": true }, "run": { "type": "object", "required": ["backend", "device", "units"], "additionalProperties": true } }
            },
            "embeddings": {
              "type": "object", "additionalProperties": false, "required": ["file", "provider", "model", "dimensions"],
              "properties": { "file": { "$ref": "#/$defs/path" }, "provider": { "enum": ["embeddinggemma", "hashed-tfidf"] }, "model": { "type": "string", "minLength": 1 },
                "revision": { "type": "string", "pattern": "^[0-9a-f]{40}$" }, "dimensions": { "type": "integer", "minimum": 1, "maximum": 8192 },
                "run": {
                  "type": "object", "additionalProperties": false, "required": ["texts", "distinct", "cached", "embedded", "seconds"],
                  "properties": {
                    "texts": { "type": "integer", "minimum": 0 }, "distinct": { "type": "integer", "minimum": 0 }, "cached": { "type": "integer", "minimum": 0 },
                    "embedded": { "type": "integer", "minimum": 0 }, "seconds": { "type": "number", "minimum": 0 },
                    "runtime": {
                      "type": "object", "additionalProperties": true, "required": ["device", "dtype", "batchSize", "textsPerSecond", "seconds", "packages"],
                      "properties": { "device": { "type": "string" }, "dtype": { "type": "string" }, "batchSize": { "type": "integer", "minimum": 1 },
                        "textsPerSecond": { "type": ["number", "null"] }, "seconds": { "type": "number" }, "packages": { "type": "object", "additionalProperties": { "type": "string" } } }
                    }
                  }
                } }
            }
          }
        },
        "createdAt": { "type": "string", "format": "date-time" },
        "request": {
          "type": "object", "additionalProperties": false, "required": ["digest"],
          "properties": { "digest": { "$ref": "#/$defs/digest" } }
        },
        "cohorts": {
          "type": "array", "minItems": 1,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["id", "title", "sourceDigest", "cohortDigest", "attempts", "assertions", "report"],
            "properties": {
              "id": { "$ref": "#/$defs/identifier" },
              "title": { "type": "string", "minLength": 1 },
              "sourceDigest": { "$ref": "#/$defs/digest" },
              "cohortDigest": { "$ref": "#/$defs/digest" },
              "attempts": { "type": "integer", "minimum": 0 },
              "assertions": { "type": "integer", "minimum": 0 },
              "report": { "$ref": "#/$defs/path" }
            }
          }
        },
        "tables": {
          "type": "object",
          "additionalProperties": {
            "type": "object", "additionalProperties": false, "required": ["path", "rows", "sha256"],
            "properties": { "path": { "$ref": "#/$defs/path" }, "rows": { "type": "integer", "minimum": 0 }, "sha256": { "$ref": "#/$defs/digest" } }
          }
        },
        "files": {
          "type": "array",
          "items": {
            "type": "object", "additionalProperties": false, "required": ["path", "bytes", "sha256", "role"],
            "properties": {
              "path": { "$ref": "#/$defs/path" },
              "bytes": { "type": "integer", "minimum": 0 },
              "sha256": { "$ref": "#/$defs/digest" },
              "role": { "type": "string", "minLength": 1, "maxLength": 100 }
            }
          }
        }
      }
    }
  }
}
