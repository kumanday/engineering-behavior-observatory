{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ebo:schema:decision-model-judge:v1",
  "title": "EBO decision-model judging: run spec and external result line",
  "$defs": {
    "identifier": { "type": "string", "minLength": 1, "maxLength": 1024, "pattern": ".*\\S.*" },
    "path": { "type": "string", "minLength": 1, "maxLength": 4096, "pattern": ".*\\S.*" },
    "cardId": { "type": "string", "pattern": "^[A-Z]{2}-[0-9]{2}$" },
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "model", "version"],
      "properties": {
        "provider": { "$ref": "#/$defs/identifier" },
        "model": { "$ref": "#/$defs/identifier" },
        "version": { "$ref": "#/$defs/identifier" },
        "configurationDigest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
      }
    },
    "run": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "corpusRoot", "corpusIndex", "provider", "thresholds", "output"],
      "properties": {
        "schemaVersion": { "const": "ebo.decision-model-run/v1" },
        "corpusRoot": { "$ref": "#/$defs/path" },
        "corpusIndex": { "$ref": "#/$defs/path" },
        "cards": { "type": "array", "minItems": 1, "maxItems": 1000, "uniqueItems": true, "items": { "$ref": "#/$defs/cardId" } },
        "provider": {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "model"],
          "properties": {
            "id": { "enum": ["typesafe", "fireworks"] },
            "model": { "$ref": "#/$defs/identifier" }
          }
        },
        "thresholds": { "$ref": "urn:ebo:schema:behavior-assertions:v1#/$defs/decisionModelJudgment/properties/thresholds" },
        "batchSize": { "type": "integer", "minimum": 1, "maximum": 93 },
        "concurrency": { "type": "integer", "minimum": 1, "maximum": 256 },
        "requestsPerSecond": { "type": "number", "exclusiveMinimum": 0, "maximum": 1000 },
        "output": { "$ref": "#/$defs/path" }
      }
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "runId", "attemptId", "cardId", "probabilities", "producer", "evidence"],
      "properties": {
        "schemaVersion": { "const": "ebo.decision-model-result/v1" },
        "runId": { "$ref": "#/$defs/identifier" },
        "attemptId": { "$ref": "#/$defs/identifier" },
        "cardId": { "$ref": "#/$defs/cardId" },
        "probabilities": { "$ref": "urn:ebo:schema:behavior-assertions:v1#/$defs/decisionModelJudgment/properties/probabilities" },
        "producer": { "$ref": "#/$defs/producer" },
        "evidence": { "$ref": "urn:ebo:schema:behavior-assertions:v1#/$defs/decisionModelEvidence" }
      }
    }
  }
}
