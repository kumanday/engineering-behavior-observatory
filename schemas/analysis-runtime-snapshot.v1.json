{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ebo:schema:analysis-runtime-snapshot:v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "source",
    "nodeVersion",
    "builder",
    "entry",
    "exports",
    "dependencies",
    "files"
  ],
  "properties": {
    "schemaVersion": {
      "const": "ebo.analysis-runtime-snapshot/v1"
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "commit"
      ],
      "properties": {
        "repository": {
          "const": "https://github.com/kumanday/engineering-behavior-observatory"
        },
        "commit": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        }
      }
    },
    "nodeVersion": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "builder": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version"
      ],
      "properties": {
        "id": {
          "const": "esbuild"
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      }
    },
    "entry": {
      "const": "dist/src/reader.mjs"
    },
    "exports": {
      "type": "array",
      "maxItems": 64,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256
      }
    },
    "dependencies": {
      "type": "object",
      "maxProperties": 128,
      "propertyNames": {
        "pattern": "^(?:@[a-z0-9_.-]+/)?[a-z0-9_.-]+$"
      },
      "additionalProperties": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256
      }
    },
    "files": {
      "type": "array",
      "maxItems": 512,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "bytes",
          "digest"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "bytes": {
            "type": "integer",
            "minimum": 0,
            "maximum": 16777216
          },
          "digest": {
            "type": "string",
            "pattern": "^sha256:[a-f0-9]{64}$"
          }
        }
      }
    }
  }
}
