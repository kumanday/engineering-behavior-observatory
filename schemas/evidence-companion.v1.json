{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ebo:schema:evidence-companion:v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "target",
    "kind",
    "producer",
    "authority",
    "sharingClass",
    "sourceRanges",
    "artifacts",
    "supplementalObservations",
    "coverage"
  ],
  "properties": {
    "schemaVersion": {
      "const": "ebo.evidence-companion/v1"
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "manifestDigest",
        "manifestBytesDigest",
        "runId",
        "attemptId"
      ],
      "properties": {
        "manifestDigest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "manifestBytesDigest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "runId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "attemptId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        }
      }
    },
    "kind": {
      "enum": [
        "converted-trajectory",
        "workspace-history",
        "supplemental-native"
      ]
    },
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version",
        "policyDigest"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "policyDigest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        }
      }
    },
    "authority": {
      "const": "supplemental"
    },
    "sharingClass": {
      "const": "restricted"
    },
    "sourceRanges": {
      "type": "array",
      "maxItems": 10000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "reference",
          "digest"
        ],
        "properties": {
          "reference": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "artifactId",
              "recordLocator"
            ],
            "properties": {
              "artifactId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4096
              },
              "recordLocator": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4096
              }
            }
          },
          "digest": {
            "type": "string",
            "pattern": "^sha256:[a-f0-9]{64}$"
          }
        }
      },
      "minItems": 1
    },
    "artifacts": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "path",
          "digest",
          "bytes",
          "mediaType"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "path": {
            "type": "string",
            "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.?(?:/|$))(?!.*\\\\)[^\\x00-\\x1f]+$",
            "maxLength": 4096
          },
          "digest": {
            "type": "string",
            "pattern": "^sha256:[a-f0-9]{64}$"
          },
          "bytes": {
            "type": "integer",
            "minimum": 0,
            "maximum": 16777216
          },
          "mediaType": {
            "enum": [
              "application/json",
              "application/x-ndjson",
              "text/plain"
            ]
          }
        }
      }
    },
    "supplementalObservations": {
      "type": "array",
      "maxItems": 1000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "citations",
          "attributes"
        ],
        "properties": {
          "kind": {
            "enum": [
              "context-boundary",
              "workspace-change",
              "coverage-gap",
              "conversion-diagnostic"
            ]
          },
          "citations": {
            "type": "array",
            "maxItems": 64,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "reference",
                "digest"
              ],
              "properties": {
                "reference": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "artifactId",
                    "recordLocator"
                  ],
                  "properties": {
                    "artifactId": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 4096
                    },
                    "recordLocator": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 4096
                    }
                  }
                },
                "digest": {
                  "type": "string",
                  "pattern": "^sha256:[a-f0-9]{64}$"
                }
              }
            },
            "minItems": 1
          },
          "attributes": {
            "type": "object",
            "maxProperties": 128,
            "additionalProperties": {
              "anyOf": [
                {
                  "type": [
                    "string",
                    "number",
                    "boolean",
                    "null"
                  ]
                },
                {
                  "type": "array",
                  "maxItems": 1024,
                  "items": {
                    "type": [
                      "string",
                      "number",
                      "boolean",
                      "null"
                    ]
                  }
                }
              ]
            }
          }
        }
      }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "reasons"
      ],
      "properties": {
        "status": {
          "enum": [
            "available",
            "partial",
            "unavailable"
          ]
        },
        "reasons": {
          "type": "array",
          "maxItems": 128,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "enum": [
                  "partial",
                  "unavailable"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "reasons": {
                "minItems": 1
              }
            }
          }
        }
      ]
    }
  }
}
