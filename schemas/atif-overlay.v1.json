{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ebo:schema:atif-overlay:v1",
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "nullableDigest": {
      "oneOf": [
        {
          "$ref": "#/$defs/digest"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "version",
    "harness",
    "producer",
    "rules",
    "limitations",
    "sources",
    "match",
    "family",
    "nativeAuthority"
  ],
  "properties": {
    "schemaVersion": {
      "const": "ebo.atif-overlay/v1"
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "harness": {
      "type": "string",
      "pattern": "^atif\\."
    },
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "formatVersion",
        "agent",
        "converter",
        "context"
      ],
      "properties": {
        "formatVersion": {
          "type": "string",
          "minLength": 1
        },
        "agent": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "name",
            "version"
          ],
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1
            },
            "version": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        },
        "converter": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "packageVersion",
            "sourceDigest"
          ],
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1
            },
            "packageVersion": {
              "type": "string",
              "minLength": 1
            },
            "sourceDigest": {
              "$ref": "#/$defs/nullableDigest"
            }
          }
        },
        "context": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "revision",
            "wrapperDigest"
          ],
          "properties": {
            "kind": {
              "enum": [
                "harbor",
                "harness-leaderboard",
                "unknown"
              ]
            },
            "revision": {
              "type": [
                "string",
                "null"
              ]
            },
            "wrapperDigest": {
              "$ref": "#/$defs/nullableDigest"
            }
          }
        }
      }
    },
    "rules": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "nativeRequests"
      ],
      "properties": {
        "nativeRequests": {
          "const": "unavailable"
        }
      }
    },
    "limitations": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "sources": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "format": "uri"
      }
    },
    "family": {
      "enum": [
        "pi",
        "codex"
      ]
    },
    "nativeAuthority": {
      "type": "string",
      "minLength": 1
    },
    "match": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "agentNames",
        "agentVersion",
        "converterIds",
        "converterVersion"
      ],
      "properties": {
        "agentNames": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "agentVersion": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "minimum",
            "before"
          ],
          "properties": {
            "minimum": {
              "type": "string",
              "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
            },
            "before": {
              "type": "string",
              "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
            }
          }
        },
        "converterIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "converterVersion": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "minimum",
            "before"
          ],
          "properties": {
            "minimum": {
              "type": "string",
              "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
            },
            "before": {
              "type": "string",
              "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
            }
          }
        }
      }
    }
  }
}
