{
  "name": "engineering-behavior-observatory",
  "version": "2.0.0-rc.2",
  "description": "Capture engineering-agent trajectories, evaluate behavior, and inspect cited evidence across harnesses.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kumanday/engineering-behavior-observatory.git"
  },
  "homepage": "https://github.com/kumanday/engineering-behavior-observatory#readme",
  "bugs": {
    "url": "https://github.com/kumanday/engineering-behavior-observatory/issues"
  },
  "keywords": [
    "agents",
    "observability",
    "evaluation",
    "opentelemetry",
    "trajectories"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "type": "module",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "bin": {
    "ebo": "./dist/src/cli.js"
  },
  "engines": {
    "node": "26.13.0"
  },
  "scripts": {
    "acceptance": "node scripts/release-acceptance.mjs",
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "npm run clean && tsc -p tsconfig.json",
    "prepack": "npm run build && npm run build:viewer",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "npm run build && node --test dist/test/*.test.js",
    "ebo": "node dist/src/cli.js",
    "build:viewer": "npm run build --workspace viewer",
    "compatibility:verify": "node scripts/compatibility/freeze-deepseek-sdk.mjs && node scripts/compatibility/freeze-v1.mjs all"
  },
  "files": [
    "contracts/",
    "dist/contracts/",
    "dist/src/",
    "docs/",
    "!docs/assets/",
    "examples/",
    "ontology/",
    "release/README.md",
    "release/0.1.0/",
    "release/0.2.0/",
    "release/0.2.1/",
    "release/0.2.2/",
    "release/0.2.3/",
    "release/0.2.4/",
    "release/0.2.5/",
    "release/0.2.6/",
    "release/0.2.7/",
    "release/0.2.8/",
    "release/0.2.9/",
    "release/0.2.10/",
    "release/1.0.0/",
    "release/1.0.1/",
    "release/1.0.2/",
    "release/1.1.0/",
    "release/1.1.1/",
    "release/1.1.2/",
    "release/1.1.3/",
    "release/1.2.0/",
    "release/1.3.0/",
    "release/1.4.0/",
    "monitor/",
    "viewer/dist/",
    "viewer/src/tokens.css",
    "schemas/",
    "scripts/atlas-grafana.sh",
    "compatibility/",
    "release/2.0.0-rc.1/",
    "release/2.0.0-rc.2/",
    "verification/"
  ],
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.319",
    "@cursor/sdk": "1.3.1",
    "@deepseek-ai/dsh-sdk-client": "0.2.2-rc.1",
    "@deepseek-ai/dsh-sdk-protocol": "0.2.2-rc.1",
    "@duckdb/node-api": "2.0.0-r.1",
    "@earendil-works/pi-codemode": "1.5.0",
    "@earendil-works/pi-coding-agent": "1.5.0",
    "@ebo-compat/ajv": "npm:ajv@8.20.0",
    "@ebo-compat/ajv-formats": "npm:ajv-formats@3.0.1",
    "@ebo-compat/anthropic-ai-claude-agent-sdk": "npm:@anthropic-ai/claude-agent-sdk@0.3.296",
    "@ebo-compat/apache-arrow": "npm:apache-arrow@21.2.0",
    "@ebo-compat/cursor-sdk": "npm:@cursor/sdk@1.0.37",
    "@ebo-compat/duckdb-node-api": "npm:@duckdb/node-api@1.5.4-r.1",
    "@ebo-compat/earendil-works-chord": "npm:@earendil-works/chord@1.1.0",
    "@ebo-compat/earendil-works-pi-agent-core": "npm:@earendil-works/pi-agent-core@1.1.0",
    "@ebo-compat/earendil-works-pi-ai": "npm:@earendil-works/pi-ai@1.1.0",
    "@ebo-compat/earendil-works-pi-codemode": "npm:@earendil-works/pi-codemode@1.1.0",
    "@ebo-compat/earendil-works-pi-coding-agent": "npm:@earendil-works/pi-coding-agent@1.1.0",
    "@ebo-compat/earendil-works-pi-mcp": "npm:@earendil-works/pi-mcp@1.1.0",
    "@ebo-compat/earendil-works-pi-telemetry": "npm:@earendil-works/pi-telemetry@1.1.0",
    "@ebo-compat/earendil-works-pi-tui": "npm:@earendil-works/pi-tui@1.1.0",
    "@ebo-compat/factory-droid-sdk": "npm:@factory/droid-sdk@0.9.1",
    "@ebo-compat/proper-lockfile": "npm:proper-lockfile@4.1.2",
    "@factory/droid-sdk": "0.10.0",
    "@renovatebot/pep440": "6.0.0",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "apache-arrow": "21.2.0",
    "proper-lockfile": "4.1.2",
    "semver": "7.8.6"
  },
  "devDependencies": {
    "@ebo-compat/esbuild": "npm:esbuild@0.28.2",
    "@types/node": "26.6.6",
    "@types/proper-lockfile": "4.1.4",
    "@typescript/typescript6": "6.0.2",
    "typescript": "7.0.2"
  },
  "workspaces": [
    "viewer"
  ],
  "packageManager": "npm@12.2.2"
}
